# ============================================================
# DATA CENTRIC AGENTIC AI — ENVIRONMENT CONFIGURATION
# ============================================================

# Application Execution Mode:
# 'local' -> Full local private mode with encrypted storage, user auth & isolated workspaces.
# 'demo'  -> Render public demonstration mode (synthetic data only, no real uploads).
APP_MODE=local

# Google Gemini API Key (Optional for basic heuristic testing, required for Gemini LLM generation)
# Obtain your key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Gemini Model Selection (e.g. gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash)
GEMINI_MODEL=gemini-1.5-flash

# Default Execution Mode for Modifications: 'CONFIRMATION' (default) or 'AUTOMATIC'
EXECUTION_MODE=CONFIRMATION

# Local Data Storage Root (strictly isolated & git-ignored)
DATA_DIR=data

